# sleeperagent configuration
# Copy to ~/.config/sleeperagent/config and chmod 600 it.
# KEY=VALUE, one per line. Values may contain spaces; quotes are optional.
# Read by scripts/*.sh and by the Phase 1 app. The file is parsed, never executed.
# Never commit the real file. It is gitignored.

# --- Pushover (required) -------------------------------------------------
# Create a dedicated application at https://pushover.net/apps
PUSHOVER_TOKEN=
# Your user key from https://pushover.net
PUSHOVER_USER=
# Device name of the parent's phone as shown in the Pushover app.
# Strongly recommended, so no other device registered to the account rings.
PUSHOVER_DEVICE=

# --- What the child sees and what the phone says --------------------------
PARENT_NAME=Parent
TITLE=I need you
MESSAGE=Please come to my room.
# Shown on the FAILED screen when the phone cannot be reached.
FALLBACK_TEXT=Go and find a grown-up.

# --- Alert behaviour ------------------------------------------------------
# Pushover sounds: persistent, siren, alarm, spacealarm, alien, echo, ...
SOUND=persistent
ESCALATE_SOUND=siren
# Pushover retries the alert every RETRY_S seconds (minimum 30)
RETRY_S=30
# ...and gives up after EXPIRE_S seconds (maximum 10800)
EXPIRE_S=3600

# --- Phase 1 kiosk only ----------------------------------------------------
POLL_S=5
ESCALATE_AFTER_S=180
# Optional command run as the last escalation rung (e.g. a voice-call script)
VOICE_CALL_HOOK=
ARRIVAL_CONFIRM=0
ARRIVAL_TIMEOUT_S=600
RESET_AFTER_S=900
NIGHT_FROM=21:00
NIGHT_TO=07:00
CALL_KEY=F12
